        "jsonBody": "={{ JSON.stringify({ model: \"claude-haiku-4-5-20251001\", max_tokens: 400, system: \"You are a logistics real-estate investment analyst. Reply only with a raw JSON object. No markdown, no extra text.\", messages: [{ role: \"user\", content: $json.prompt }] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
