    {
      "parameters": {
        "jsCode": "// Flatten organic + news results from all searches and remove duplicate URLs\nconst seen = new Set();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const results = [\n    ...(item.json.organic_results || []),\n    ...(item.json.news_results || [])\n  ];\n  for (const r of results) {\n    if (!r.link || seen.has(r.link)) continue;\n    seen.add(r.link);\n    out.push({ json: {\n      title:      (r.title || '').trim(),\n      url:        r.link,\n      snippet:    (r.snippet || '').trim(),\n      source:     r.displayed_link || r.source || '',\n      date:       r.date || '',\n      query_used: item.json.search_parameters?.q || ''\n    }});\n  }\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        860
      ],
      "id": "d2b88b4b-9e78-480a-b8ff-80f043fc1f6e",
      "name": "Normalise & De-duplicate"
    },
    {
      "parameters": {
        "jsCode": "// Rule-based triage: drop noise, tag record type, extract structured fields\nconst NOISE = [\n  'translate.google','instagram.com','linkedin.com/posts',\n  'facebook.com/groups','justdial.com','dir.indiamart.com',\n  'tradeindia.com','epack.in','ritutechnbuilds.com',\n  'wadigroup.in','jainoncor.com/blog','logisticmart.com'\n];\n\nconst INTEL = [\n  'colliers.com','cushmanwakefield.com','jll.com',\n  'pib.gov.in','pppinindia.gov.in','thehindu.com',\n  'timesofindia','economictimes','business-standard.com',\n  'livemint.com','invest.up.gov.in','iima.ac.in'\n];\n\nconst PORTAL = [/ffid$/, /pppfr$/, /pppfs$/, /\\/nct-\\d+/];\n\nconst CITIES = [\n  'Navi Mumbai','Mumbai','Thane','Pune','Indore','Bhopal',\n  'Delhi','Noida','Gurgaon','Gurugram','Bengaluru','Bangalore','Hyderabad','Chennai',\n  'Kolkata','Ahmedabad','Surat','Vadodara','Nagpur','Jaipur',\n  'Lucknow','Varanasi','Coimbatore','Bhiwandi','Kalamboli'\n];\n\nfunction recordType(url) {\n  if (NOISE.some(d => url.includes(d)))  return 'discard';\n  if (INTEL.some(d => url.includes(d)))  return 'intel';\n  if (PORTAL.some(p => p.test(url)))     return 'portal';\n  return 'listing';\n}\n\nfunction pick(text, patterns, fallback) {\n  for (const [re, val] of patterns)\n    if (re.test(text)) return val;\n  return fallback;\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  const type = recordType(r.url);\n  if (type === 'discard') continue;\n\n  const text = r.title + ' ' + r.snippet;\n\n  out.push({ json: {\n    ...r,\n    record_type:   type,\n    city:          CITIES.find(c => new RegExp('\\\\b' + c + '\\\\b', 'i').test(text)) || '',\n    property_type: pick(text, [\n      [/multimodal|mmlp/i,         'Multimodal Park'],\n      [/cold.?storage/i,           'Cold Storage'],\n      [/logistics.?park/i,         'Logistics Park'],\n      [/industrial.?(land|plot)/i, 'Industrial Land'],\n      [/warehouse|godown|gala/i,   'Warehouse']\n    ], 'Other'),\n    deal_type: pick(text, [\n      [/\\brent\\b|\\blease/i,    'Rent/Lease'],\n      [/\\bsale\\b|freehold/i,   'Sale']\n    ], 'Unknown'),\n    area:  (text.match(/[\\d,.]+\\s*(sq\\.?\\s*ft|sqft|sq\\.?\\s*yd|sq\\.?\\s*m|acres?)\\b/i) || [])[0] || '',\n    price: (text.match(/(₹|Rs\\.?|INR)\\s*[\\d,.]+\\s*(L|Cr|lakh|lac|crore)?/i) || [])[0] || '',\n    scraped_date: new Date().toISOString().split('T')[0]\n  }});\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        860
      ],
      "id": "9b65d643-f714-484a-aaae-2eaf7098b57a",
      "name": "Classify & Extract Fields"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "54a93d19-818e-4067-bdf3-baa8e6f45d3d",
              "leftValue": "={{ $json.record_type }}",
              "rightValue": "listing",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "a0dc4b7f-ff12-4abb-af91-38c0bf121b8d",
              "leftValue": "={{ $json.record_type }}",
              "rightValue": "portal",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1460,
        860
      ],
      "id": "2a4cd40f-0222-4bd7-b299-8faf6896f0ca",
      "name": "Keep Property Records Only"
    },
    {
      "parameters": {
        "jsCode": "// Build a scoring prompt per property. All original fields are kept on the item\n// so the parse step can recover them after the API call (via paired items).\nfunction clean(v, max = 300) {\n  return String(v || '')\n    .replace(/[\\u0000-\\u001F\\u007F]/g, ' ')   // control characters only\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, max);\n}\n\nreturn $input.all().map(item => {\n  const r = item.json;\n\n  const prompt = [\n    'Evaluate this property as a potential site for a logistics real-estate developer with three product lines:',\n    '- \"Multimodal Park\": large multimodal logistics parks (rail/road connected, typically 50+ acres)',\n    '- \"Regional Warehouse\": Grade-A warehouses in Tier 2 and Tier 3 cities',\n    '- \"Urban Last-Mile\": small urban fulfilment hubs close to consumers in metro cities',\n    '',\n    'Property:',\n    'Title: ' + clean(r.title),\n    'City: ' + (clean(r.city) || 'Unknown'),\n    'Property type: ' + clean(r.property_type),\n    'Deal type: ' + clean(r.deal_type),\n    'Area: ' + (clean(r.area) || 'Not stated'),\n    'Price: ' + (clean(r.price) || 'Not stated'),\n    'Details: ' + clean(r.snippet),\n    'Source: ' + clean(r.source),\n    '',\n    'Reply with ONLY a JSON object with these keys:',\n    'score (integer 1-10), product_fit (\"Multimodal Park\" | \"Regional Warehouse\" | \"Urban Last-Mile\" | \"None\"),',\n    'deal_fit (\"High\" | \"Medium\" | \"Low\"), action (\"Pursue\" | \"Shortlist\" | \"Monitor\" | \"Skip\"),',\n    'strategic_note (max 20 words), risk (max 15 words).',\n    'Example: {\"score\":7,\"product_fit\":\"Regional Warehouse\",\"deal_fit\":\"High\",\"action\":\"Shortlist\",\"strategic_note\":\"Highway-adjacent plot in growing Tier 2 consumption hub\",\"risk\":\"Land title and zoning unverified\"}'\n  ].join('\\n');\n\n  return { json: { ...r, prompt } };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        860
      ],
      "id": "b8c69f2f-f447-49ab-a27a-d79b30dd9c35",
      "name": "Build AI Scoring Prompt"
    },
