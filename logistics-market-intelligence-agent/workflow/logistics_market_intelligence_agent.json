      "id": "67aa6ed8-5397-4df7-8af0-a83a414542cd",
      "name": "Claude: Score Opportunity"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once per item: parse Claude's JSON verdict and re-attach the original listing fields\nconst src = $('Build AI Scoring Prompt').item.json;   // original record (paired item)\nconst raw = $json.content?.[0]?.text || '';\n\nlet ai;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);              // tolerate stray text around the JSON\n  ai = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  ai = { score: 0, product_fit: 'None', deal_fit: 'Low', action: 'Skip',\n         strategic_note: 'AI response could not be parsed', risk: '' };\n}\n\nreturn { json: {\n  scraped_date:   src.scraped_date  || '',\n  title:          src.title         || '',\n  city:           src.city          || '',\n  property_type:  src.property_type || '',\n  deal_type:      src.deal_type     || '',\n  area:           src.area          || '',\n  price:          src.price         || '',\n  record_type:    src.record_type   || '',\n  source:         src.source        || '',\n  url:            src.url           || '',\n  snippet:        (src.snippet || '').slice(0, 300),\n  query_used:     src.query_used    || '',\n  ai_score:       Math.max(0, Math.min(10, Number(ai.score) || 0)),\n  product_fit:    ai.product_fit    || 'None',\n  deal_fit:       ai.deal_fit       || '',\n  action:         ai.action         || 'Skip',\n  strategic_note: ai.strategic_note || '',\n  risk:           ai.risk           || ''\n}};\n"
      },
